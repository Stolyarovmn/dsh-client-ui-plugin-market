diff --git a/packages/client/ui-plugin-manager/src/client/index.ts b/packages/client/ui-plugin-manager/src/client/index.ts
--- a/packages/client/ui-plugin-manager/src/client/index.ts
+++ b/packages/client/ui-plugin-manager/src/client/index.ts
@@
 import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
+import { resolveSlotLabel } from '@deepseek-ai/dsh-client-ui-slots'
@@
-import { PluginManagerPage } from './PluginManagerPage.tsx'
+import { PluginManagerPage, type PluginListTabEntry } from './PluginManagerPage.tsx'
@@
   const configLedger = configLedgerSource(ctx)
-  const face = controller.inject(configLedger, text => ctx.locale.resolveText(text))
+  let listTabsVersion = -1
+  let listTabsRevision = -1
+  let listTabs: readonly PluginListTabEntry[] = []
+  const listTabsSource = {
+    getSnapshot: () => {
+      const version = ctx.slots.getVersion('plugins.list.tab')
+      const revision = ctx.locale.getSnapshot().revision
+      if (version !== listTabsVersion || revision !== listTabsRevision) {
+        listTabsVersion = version
+        listTabsRevision = revision
+        listTabs = ctx.slots.entries('plugins.list.tab')
+          .map(entry => ({
+            id: entry.options.id ?? '',
+            order: entry.options.order ?? 0,
+            label: resolveSlotLabel(entry.options.label) ?? '',
+          }))
+          .sort((a, b) => a.order - b.order)
+      }
+      return listTabs
+    },
+    subscribe: (listener: () => void) => {
+      const offSlots = ctx.slots.subscribe('plugins.list.tab', listener)
+      const offLocale = ctx.locale.subscribe(listener)
+      return () => { offSlots(); offLocale() }
+    },
+  }
+  const baseFace = controller.inject(configLedger, text => ctx.locale.resolveText(text))
+  const face = { ...baseFace, hooks: { ...baseFace.hooks, listTabs: listTabsSource } }
@@
       children: {
+        'plugins.list.tab': { kind: 'list', scope: 'root' },
+        'plugins.list.action': { kind: 'list', scope: 'root' },
         'plugins.item': { kind: 'list', scope: 'root' },
