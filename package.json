{
	"name": "@stolyarovmn/dsh-ui-registry-aggregator",
	"description": "Federated plugin registry aggregator for DeepSeek Harness: combine trusted sources, search one index, and install through the native Plugin Manager.",
	"version": "0.4.0",
	"author": {
		"name": "Stolyarovmn",
		"url": "https://github.com/Stolyarovmn"
	},
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./core": "./lib/core.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "node --test test/*.test.js",
		"test:pack": "npm pack --dry-run --json"
	},
	"files": [
		"lib/*.js",
		"cordis.patch.yml",
		"README.md",
		"LICENSE",
		"icon.svg"
	],
	"keywords": [
		"dsh",
		"deepseek-harness",
		"dsh-plugin",
		"plugin",
		"registry",
		"aggregator",
		"registry-aggregator",
		"plugin-registry",
		"plugin-sources",
		"federated-search"
	],
	"dependencies": {
		"@deepseek-ai/dsh-client-connection": "0.1.7-rc.1",
		"@deepseek-ai/schemastery": "^3.18.2",
		"ipaddr.js": "^2.2.0",
		"undici": "^7.16.0",
		"@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.1"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-connection",
				"@deepseek-ai/dsh-api-remotes",
				"@deepseek-ai/dsh-client-locale",
				"@deepseek-ai/dsh-client-ui-settings",
				"@deepseek-ai/dsh-client-ui-plugin-manager",
				"@deepseek-ai/dsh-client-ui-primitives"
			]
		},
		"catalog": {
			"category": "ui",
			"summary": {
				"en": "Registry Aggregator for DSH 0.1.7+: combine trusted plugin sources, search them as one index, and install through the native Plugin Manager.",
				"zh": "DeepSeek Harness 0.1.7+ 插件注册源聚合器：聚合可信来源、统一搜索，并通过原生 Plugin Manager 安装。"
			},
			"capabilities": [
				"slots",
				"settings",
				"network",
				"plugin-manager"
			]
		}
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.2.0"
	},
	"icon": "./icon.svg",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Stolyarovmn/dsh-ui-registry-aggregator.git"
	},
	"homepage": "https://github.com/Stolyarovmn/dsh-ui-registry-aggregator#readme",
	"bugs": {
		"url": "https://github.com/Stolyarovmn/dsh-ui-registry-aggregator/issues"
	}
}
