{
	"name": "@stolyarovmn/dsh-client-ui-plugin-market",
	"description": "Federated marketplace discovery for DeepSeek Harness: browse trusted plugin sources, compare metadata, and install through the native Plugin Manager.",
	"version": "0.3.1",
	"author": {
		"name": "Stolyarovmn",
		"url": "https://github.com/Stolyarovmn"
	},
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./core": "./lib/core.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "node --test test/*.test.js",
		"test:pack": "npm pack --dry-run --json"
	},
	"files": [
		"lib/*.js",
		"cordis.patch.yml",
		"README.md",
		"LICENSE",
		"icon.svg"
	],
	"keywords": [
		"dsh",
		"deepseek-harness",
		"dsh-plugin",
		"plugin",
		"marketplace",
		"registry",
		"plugin-sources",
		"federated-search",
		"settings"
	],
	"dependencies": {
		"@deepseek-ai/dsh-client-connection": "0.1.7-rc.1",
		"@deepseek-ai/schemastery": "^3.18.2",
		"ipaddr.js": "^2.2.0",
		"undici": "^7.16.0"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-connection",
				"@deepseek-ai/dsh-api-remotes",
				"@deepseek-ai/dsh-client-locale",
				"@deepseek-ai/dsh-client-ui-settings",
				"@deepseek-ai/dsh-client-ui-plugin-manager"
			]
		},
		"catalog": {
			"category": "ui",
			"summary": {
				"en": "Federated marketplace discovery for DeepSeek Harness 0.1.7+: browse trusted sources, compare plugin evidence, and install through the native Plugin Manager.",
				"zh": "DeepSeek Harness 0.1.7+ 联合插件市场发现层：浏览可信来源，并通过原生 Plugin Manager 安装。"
			},
			"capabilities": [
				"slots",
				"settings",
				"network",
				"plugin-manager"
			]
		}
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.2.0"
	},
	"icon": "./icon.svg"
}
